# Backend — copiar a .env (no commitear .env)

NODE_ENV=development
# En el local de la cafetería debe ser production: sin esto NO se imprime.
# NODE_ENV=production

PORT=3000
HOST=0.0.0.0

JWT_SECRET=cambiar-este-secreto

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB=hansel_y_gretel

# Orígenes del front (notebook + tablet). Sin espacios de más.
# Ejemplo tablet: http://192.168.70.10:3001
ALLOWED_ORIGINS=http://localhost:3001

# Impresora comandera Ethernet (defaults = LAN actual)
PRINTER_HOST=192.168.70.3
PRINTER_PORT=9100
PRINTER_TIMEOUT=4000
PRINTER_RETRIES=1
