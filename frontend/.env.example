# Frontend — copiar a .env.local (dev) o .env.production (cafetería)
# No commitear archivos .env reales.

# Desarrollo (npm run dev): usa *_DEV
NEXT_PUBLIC_API_URL_DEV=http://localhost:3000
NEXT_PUBLIC_WS_URL_DEV=http://localhost:3000

# Producción / LAN: NODE_ENV=production al build. La tablet NO debe usar localhost.
# Usar la IP de la notebook en la red del local.
NEXT_PUBLIC_API_URL=http://192.168.70.X:3000
NEXT_PUBLIC_WS_URL=http://192.168.70.X:3000
